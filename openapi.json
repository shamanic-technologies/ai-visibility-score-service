            "name": "x-campaign-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional caller feature slug, forwarded to downstream services for tracking."
            },
            "required": false,
            "description": "Optional caller feature slug, forwarded to downstream services for tracking.",
            "name": "x-feature-slug",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional caller workflow slug, forwarded to downstream services for tracking."
            },
            "required": false,
            "description": "Optional caller workflow slug, forwarded to downstream services for tracking.",
            "name": "x-workflow-slug",
