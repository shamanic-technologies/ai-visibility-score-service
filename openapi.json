          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "description": "Internal org UUID",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID"
            },
            "required": false,
            "description": "Internal user UUID",
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
