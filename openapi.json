{
  "openapi": "3.0.0",
  "info": {
    "title": "AI Visibility Score Service",
    "description": "Runs an N-prompt LLM audit per brand to measure brand visibility vs. competitors and persists time-series metrics.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "ai-visibility-score-service"
            ]
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "VisibilityScoreRunResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibilityScoreRunResult"
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "VisibilityScoreRunResult": {
        "type": "object",
        "properties": {
          "run": {
            "$ref": "#/components/schemas/VisibilityScoreRunRow"
          },
          "by_provider": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibilityScoreByProviderResult"
            },
            "description": "One entry per judge provider in the run. Order matches the server config."
          },
          "top_competitors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopCompetitor"
            },
            "description": "Top competitors unioned across all judges (by competitor name)."
          },
          "citation_opportunities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CitationOpportunity"
            },
            "description": "Citation domains unioned across all judges."
          },
          "ahrefs": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed"
                ],
                "description": "`completed` = Ahrefs returned data. `failed` = fetch failed (see `error`); the visibility run still succeeded."
              },
              "domain": {
                "type": "string"
              },
              "snapshotDate": {
                "type": "string",
                "nullable": true,
                "description": "Date the Ahrefs data reflects (distinct from `createdAt`)."
              },
              "fetchedFromCache": {
                "type": "boolean",
                "nullable": true
              },
              "mentionsTotal": {
                "type": "number",
                "nullable": true,
                "description": "Global brand mentions across all AI engines. Raw count — not a score."
              },
              "mentionsByEngine": {
                "type": "array",
                "nullable": true,
                "items": {
                  "$ref": "#/components/schemas/AhrefEngineMention"
                }
              },
              "topCompetitors": {
                "type": "array",
                "nullable": true,
                "items": {
                  "$ref": "#/components/schemas/AhrefTopCompetitor"
                },
                "description": "Top competitor brands by global citation count."
              },
              "error": {
                "type": "string",
                "nullable": true
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "domain",
              "snapshotDate",
              "fetchedFromCache",
              "mentionsTotal",
              "mentionsByEngine",
              "topCompetitors",
              "error",
              "createdAt"
            ],
            "description": "Raw Ahrefs Brand-Radar AI-visibility snapshot for the brand domain at run time (mentions global + per-engine + top cited competitors). Supplementary to the LLM score; null when not persisted. Present on POST run responses."
          }
        },
        "required": [
          "run",
          "by_provider",
          "top_competitors",
          "citation_opportunities"
        ]
      },
      "VisibilityScoreRunRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "brandId": {
            "type": "string",
            "format": "uuid"
          },
          "campaignId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "featureSlug": {
            "type": "string",
            "nullable": true
          },
          "workflowSlug": {
            "type": "string",
            "nullable": true
          },
          "parentRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "aggregateRunId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "When non-null, this row is a per-provider child of the aggregate run with this id."
          },
          "judgeKind": {
            "type": "string",
            "enum": [
              "aggregate",
              "per_provider"
            ],
            "description": "`aggregate` = parent row, mean across providers. `per_provider` = single judge child row."
          },
          "domain": {
            "type": "string"
          },
          "brandName": {
            "type": "string"
          },
          "llmProvider": {
            "type": "string"
          },
          "llmModel": {
            "type": "string"
          },
          "promptGenModel": {
            "type": "string"
          },
          "extractionProvider": {
            "type": "string"
          },
          "extractionModel": {
            "type": "string"
          },
          "nPrompts": {
            "type": "number"
          },
          "weights": {
            "$ref": "#/components/schemas/VisibilityWeights"
          },
          "visibilityScore": {
            "type": "string",
            "nullable": true,
            "description": "Composite score, decimal 0–1 (clamped). Multiply by 100 for percentage display."
          },
          "brandMentionRate": {
            "type": "string",
            "nullable": true,
            "description": "Fraction of prompts that mentioned the brand. Decimal 0–1."
          },
          "shareOfVoice": {
            "type": "string",
            "nullable": true,
            "description": "Brand mentions / (brand + competitor mentions). Decimal 0–1."
          },
          "netSentiment": {
            "type": "string",
            "nullable": true,
            "description": "(positive - negative) / brand_mention_count. Decimal in [-1, 1]."
          },
          "citationRate": {
            "type": "string",
            "nullable": true,
            "description": "Citations of the brand domain / N prompts. Decimal 0–1."
          },
          "avgPosition": {
            "type": "string",
            "nullable": true,
            "description": "Mean rank of brand among mentions in responses (1 = first). Lower is better."
          },
          "promptGenSystemPrompt": {
            "type": "string",
            "nullable": true,
            "description": "Exact system prompt string sent to the prompt-generator LLM (one call per run, drives the prompts the judges then answer)."
          },
          "promptGenUserMessage": {
            "type": "string",
            "nullable": true,
            "description": "Exact user message string sent to the prompt-generator LLM. Includes the brand context fields (category, specific_offerings, target_audience, primary_geography, positioning) — these influence which prompts get generated."
          },
          "status": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "orgId",
          "userId",
          "brandId",
          "campaignId",
          "featureSlug",
          "workflowSlug",
          "parentRunId",
          "runId",
          "aggregateRunId",
          "judgeKind",
          "domain",
          "brandName",
          "llmProvider",
          "llmModel",
          "promptGenModel",
          "extractionProvider",
          "extractionModel",
          "nPrompts",
          "weights",
          "visibilityScore",
          "brandMentionRate",
          "shareOfVoice",
          "netSentiment",
          "citationRate",
          "avgPosition",
          "status",
          "startedAt",
          "completedAt",
          "createdAt"
        ],
        "additionalProperties": {
          "nullable": true
        },
        "description": "Aggregate parent row. Metrics are the mean across all judge providers."
      },
      "VisibilityWeights": {
        "type": "object",
        "properties": {
          "brandMentionRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citationRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "positionScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "shareOfVoice": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sentiment": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "brandAndUrlRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "brandMentionRate",
          "citationRate",
          "positionScore",
          "shareOfVoice",
          "sentiment",
          "brandAndUrlRate"
        ]
      },
      "VisibilityScoreByProviderResult": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/VisibilityScoreRunRow"
          },
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptDetail"
            }
          },
          "competitors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitorDetail"
            }
          },
          "top_competitors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopCompetitor"
            }
          },
          "citation_opportunities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CitationOpportunity"
            }
          }
        },
        "required": [
          "provider",
          "model",
          "run",
          "prompts",
          "competitors",
          "top_competitors",
          "citation_opportunities"
        ]
      },
      "PromptDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "promptIndex": {
            "type": "number"
          },
          "promptText": {
            "type": "string"
          },
          "judgeSystemPrompt": {
            "type": "string",
            "nullable": true,
            "description": "Exact system prompt string sent to the judge LLM. Persisted for full debug transparency."
          },
          "judgeUserMessage": {
            "type": "string",
            "nullable": true,
            "description": "Exact user message string sent to the judge LLM. Equals `promptText` (server does NOT inject brand context into the judge call)."
          },
          "extractorSystemPrompt": {
            "type": "string",
            "nullable": true,
            "description": "Exact system prompt string sent to the extractor LLM (the extractor analyzes the judge's output)."
          },
          "extractorUserMessage": {
            "type": "string",
            "nullable": true,
            "description": "Exact user message string sent to the extractor LLM. Includes `Target brand: <name + domain>` + the judge response."
          },
          "responseText": {
            "type": "string"
          },
          "responseLengthChars": {
            "type": "number",
            "nullable": true
          },
          "brandFound": {
            "type": "boolean",
            "nullable": true
          },
          "brandCount": {
            "type": "number",
            "nullable": true
          },
          "brandPosition": {
            "type": "number",
            "nullable": true
          },
          "urlFound": {
            "type": "boolean",
            "nullable": true
          },
          "urlCount": {
            "type": "number",
            "nullable": true
          },
          "brandAndUrlCoOccurrence": {
            "type": "boolean",
            "nullable": true
          },
          "maxBrandsInResponse": {
            "type": "number",
            "nullable": true
          },
          "sentiment": {
            "type": "string",
            "nullable": true
          },
          "sentimentScore": {
            "type": "string",
            "nullable": true
          },
          "citationUrls": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "latencyMs": {
            "type": "number",
            "nullable": true
          },
          "tokensInput": {
            "type": "number",
            "nullable": true
          },
          "tokensOutput": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "promptIndex",
          "promptText",
          "judgeSystemPrompt",
          "judgeUserMessage",
          "extractorSystemPrompt",
          "extractorUserMessage",
          "responseText",
          "responseLengthChars",
          "brandFound",
          "brandCount",
          "brandPosition",
          "urlFound",
          "urlCount",
          "brandAndUrlCoOccurrence",
          "maxBrandsInResponse",
          "sentiment",
          "sentimentScore",
          "citationUrls",
          "latencyMs",
          "tokensInput",
          "tokensOutput"
        ]
      },
      "CompetitorDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "promptIdFk": {
            "type": "string",
            "format": "uuid"
          },
          "competitorName": {
            "type": "string"
          },
          "competitorUrl": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "number",
            "nullable": true
          },
          "sentiment": {
            "type": "string",
            "nullable": true
          },
          "sentimentScore": {
            "type": "string",
            "nullable": true
          },
          "citationUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "promptIdFk",
          "competitorName",
          "competitorUrl",
          "position",
          "sentiment",
          "sentimentScore",
          "citationUrl"
        ]
      },
      "TopCompetitor": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "mention_count": {
            "type": "number"
          },
          "avg_position": {
            "type": "number",
            "nullable": true
          },
          "share_of_voice": {
            "type": "number"
          },
          "net_sentiment": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "url",
          "mention_count",
          "avg_position",
          "share_of_voice",
          "net_sentiment"
        ]
      },
      "CitationOpportunity": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "domain",
          "count"
        ]
      },
      "AhrefEngineMention": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string",
            "description": "AI search engine key (lower-snake-case, e.g. `chatgpt`, `perplexity`)."
          },
          "mentions": {
            "type": "number",
            "description": "Brand mentions in this engine."
          }
        },
        "required": [
          "engine",
          "mentions"
        ]
      },
      "AhrefTopCompetitor": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "nullable": true
          },
          "citations": {
            "type": "number",
            "description": "Global citation count for this competitor brand."
          }
        },
        "required": [
          "brand",
          "domain",
          "citations"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "VisibilityScoreRunRequest": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Empty body. The brand to audit is specified via the `x-brand-id` header. All LLM provider/model choices, prompt count, and scoring weights are decided server-side from a canonical config and are not caller-configurable."
      },
      "VisibilityScoreRunListResponse": {
        "type": "object",
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibilityScoreRunListItem"
            }
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "runs",
          "limit",
          "offset"
        ]
      },
      "VisibilityScoreRunListItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/VisibilityScoreRunRow"
          },
          {
            "type": "object",
            "properties": {
              "visibility_score_delta": {
                "type": "string",
                "nullable": true
              },
              "share_of_voice_delta": {
                "type": "string",
                "nullable": true
              },
              "net_sentiment_delta": {
                "type": "string",
                "nullable": true
              },
              "position_delta": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "visibility_score_delta",
              "share_of_voice_delta",
              "net_sentiment_delta",
              "position_delta"
            ],
            "additionalProperties": {
              "nullable": true
            }
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "OpenAPI specification",
        "responses": {
          "200": {
            "description": "Spec",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {
                    "nullable": true
                  }
                }
              }
            }
          },
          "404": {
            "description": "Spec not generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/visibility-score-runs": {
      "post": {
        "tags": [
          "VisibilityScore"
        ],
        "summary": "Run a visibility-score audit for a single brand",
        "description": "Runs an N-prompt LLM audit against the brand identified by `x-brand-id`, extracts structured metrics for the target brand vs. competitors, persists rows, and returns the full bundle.\n\nThe request body MUST be empty (`{}`). All LLM provider/model choices, prompt count, and scoring weights are decided server-side from a canonical config and cannot be overridden by the caller — to change them, ship a new version of the service.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Service-to-service API key"
            },
            "required": true,
            "description": "Service-to-service API key",
            "name": "x-api-key",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "description": "Internal org UUID",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID"
            },
            "required": false,
            "description": "Internal user UUID",
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Caller's run ID — captured as parentRunId when this service creates its own run"
            },
            "required": false,
            "description": "Caller's run ID — captured as parentRunId when this service creates its own run",
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Optional caller campaign UUID, forwarded to downstream chat-service / brand-service for tracking."
            },
            "required": false,
            "description": "Optional caller campaign UUID, forwarded to downstream chat-service / brand-service for tracking.",
            "name": "x-campaign-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional caller feature slug, forwarded to downstream services for tracking."
            },
            "required": false,
            "description": "Optional caller feature slug, forwarded to downstream services for tracking.",
            "name": "x-feature-slug",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional caller workflow slug, forwarded to downstream services for tracking."
            },
            "required": false,
            "description": "Optional caller workflow slug, forwarded to downstream services for tracking.",
            "name": "x-workflow-slug",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Single brand UUID to audit. Required. Co-branding is not supported — exactly one UUID, no comma-separated list."
            },
            "required": true,
            "description": "Single brand UUID to audit. Required. Co-branding is not supported — exactly one UUID, no comma-separated list.",
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibilityScoreRunRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisibilityScoreRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Run-tracking dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "VisibilityScore"
        ],
        "summary": "List visibility-score runs with deltas",
        "description": "Returns runs scoped to the requesting org, optionally filtered by brandId/campaignId/domain/date range. Each row includes a delta block vs. the immediately previous run for the same brand.",
